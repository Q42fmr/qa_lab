# =============================================================================
# qa_lab — шаблон .env для ПРОДА
# =============================================================================
# Це НЕ файл для людини. Його рендерить пайплайн: копіює в .env і підставляє
# кожен плейсхолдер значенням однойменної CI-змінної через sed.
#
# Для локальної роботи є `.env.example` — там усе з коментарями і реальними
# дефолтами. Цей файл свідомо мінімальний і містить лише те, що потрібно
# контейнеру в проді.
#
# ⚠️ ТРИМАТИ В LOCKSTEP З `.gitlab-ci.yml`: кожен плейсхолдер тут мусить мати
# свій рядок sed там. Guard у пайплайні падає на будь-якому нерозв'язаному
# плейсхолдері — саме щоб він не поїхав у прод літералом.
#
# ⚠️ У цьому файлі НЕ має бути подвійних фігурних дужок у коментарях: guard
#    шукає їх по всьому файлу (як у сусідніх проєктах), а не лише у
#    присвоєннях.
#
# ⚠️ Значення CI-змінних НЕ мають містити символ `|` — він розділювач у sed.
#    GitLab-PAT, ClickUp-токени і bcrypt-хеші безпечні.

# --- де живе стан -----------------------------------------------------------
# Змонтований volume. Без цього стан лежав би в шарі образу і зникав при
# кожному оновленні сервісу.
QA_LAB_STATE_DIR=/app/var

# --- координати образу (для docker stack deploy) ----------------------------
CI_REGISTRY_IMAGE={{CI_REGISTRY_IMAGE}}
IMAGE_TAG={{IMAGE_TAG}}

# --- публічна адреса --------------------------------------------------------
# CI-змінна DOMAIN_NAME, обов'язкова — пайплайн падає, якщо порожня.
# Домовлена адреса: lab.example.com
# (сусідній стек на тому ж домені — parser-ui.example.com)
DOMAIN_NAME={{DOMAIN_NAME}}

# --- користувачі і вхід у застосунок ----------------------------------------
# Сховище користувачів. Порожній MONGO_URI = users.json у корені стану
# (так лаба працює нативно, без піднятої Mongo).
MONGO_URI={{MONGO_URI}}
MONGO_DB={{MONGO_DB}}
MONGO_USERS_COLL={{MONGO_USERS_COLL}}
# Скіли ШІ-моста — те, що користувач править з вкладки /ai. Порожній
# MONGO_URI = ai_skills.json у корені стану.
MONGO_SKILLS_COLL={{MONGO_SKILLS_COLL}}

# Ключ підпису сесійної куки. Порожньо — згенерується сам і збережеться у
# стані (на volume), тобто рестарт нікого не розлогінить.
QA_LAB_SECRET_KEY={{QA_LAB_SECRET_KEY}}

# --- ШІ-міст (запити від TSM) -----------------------------------------------
# Другий застосунок конвеєра шле сюди скарги прозою, лаба обирає перевірки
# через Claude, ганяє їх і — коли ввімкнено — комітить.
#
# Токен, яким автентифікується МАШИНА. Порожньо = міст закритий для всіх
# (ендпоінти віддають 401, решта лаби працює як працювала). Токен діє лише
# на /api/ai/*, тож його витік не відкриває ані коміти, ані користувачів.
# Згенерувати: openssl rand -hex 32
QA_LAB_BRIDGE_TOKEN={{QA_LAB_BRIDGE_TOKEN}}

# Ключ Claude. Порожньо = роутер працює на самих словах з карток скілів
# (гірше, але працює) — міст не падає.
ANTHROPIC_API_KEY={{ANTHROPIC_API_KEY}}
AI_MODEL={{AI_MODEL}}

# ПРАВО КОМІТИТИ. 0 — сухий прогін: міст усе рахує і пише в журнал, але в git
# не пише нічого. Вмикати в 1 лише після того, як на журналі видно, що
# роутинг не блукає.
AI_BRIDGE_APPLY={{AI_BRIDGE_APPLY}}

# З яких груп перевірок мосту дозволено ЛАГОДИТИ. `compute_fixes` сам по
# GROUP не фільтрує, тож без цієї змінної машина застосувала б і чек із
# вимкненої групи review.
AI_AUTOFIX_GROUPS={{AI_AUTOFIX_GROUPS}}

# Місячна стеля витрат на Claude, $. 0 — без обмеження. Понад стелю роутер
# штатно з'їжджає на слова, а не зупиняється.
AI_BUDGET_USD={{AI_BUDGET_USD}}

# 1 — писати результат коментарем у таску ClickUp; 0 — мовчки (на час
# сухих прогонів зручно вимкнути, щоб не смітити в тасках).
AI_CLICKUP={{AI_CLICKUP}}

# Скільки кіл лаба відпрацьовує по одній і тій самій проблемі, перш ніж
# зупинитись і покликати людину. Третій прихід за дефолту = ескалація.
AI_MAX_ROUNDS={{AI_MAX_ROUNDS}}
# Той самий дефект у межах цього вікна (сек) — дубль, а не нове коло.
AI_COOLDOWN_S={{AI_COOLDOWN_S}}

# --- прев'ю вітки на окремому піддомені -------------------------------------
# CI-змінна PREVIEW_HOST. Порожня = фіча вимкнена, і це безпечний дефолт:
# піддомен без роутера в Traefik усе одно нікуди не веде.
# Значення — ОДИН лейбл під базовим доменом: lab-preview.example.com.
# `preview.lab.example.com` НЕ підходить: wildcard (і DNS, і TLS за
# RFC 6125) матчить рівно один лейбл, тож такий хост потребував би окремого
# запису і окремого сертифіката.
PREVIEW_HOST={{PREVIEW_HOST}}

# Кука лише по https — на проді за Traefik це саме так.
QA_LAB_COOKIE_SECURE=1

# Bootstrap-адмін: єдина учетка з правами адміністратора. Створюється або
# оновлює пароль на КОЖНОМУ старті — це і спосіб змінити пароль, і гарантія,
# що вхід лишиться, навіть якщо Slack ліг.
ADMIN_LOGIN={{ADMIN_LOGIN}}
ADMIN_PASSWORD={{ADMIN_PASSWORD}}
ADMIN_NAME={{ADMIN_NAME}}

# Вхід через Slack (OIDC). Потрібні ВСІ ТРИ значення; якщо бракує хоч
# одного — модуль вимкнений, кнопки на екрані входу немає, лишається вхід за
# логіном і паролем. Це робочий стан, а не помилка: Slack підключається
# пізніше, коли є домен (він не приймає редіректи на localhost).
# SLACK_TEAM_ID у цій трійці не менш обов'язковий за решту: без нього зайти
# міг би будь-який Slack-акаунт в інтернеті.
#
# Неповну трійку деплой відхиляє голосно (guard у .gitlab-ci.yml): на двох
# заповнених значеннях модуль вимикається цілком, і ззовні це виглядає як
# «кнопка входу зникла сама собою», а причини не видно ніде.
#
# SLACK_REDIRECT_URI виводиться з DOMAIN_NAME і мусить збігатися символ у
# символ з тим, що вписано в застосунку Slack (OAuth & Permissions →
# Redirect URLs). Розбіжність Slack повертає у себе на боці як
# `bad_redirect_uri` — сюди запит не доходить узагалі.
SLACK_CLIENT_ID={{SLACK_CLIENT_ID}}
SLACK_CLIENT_SECRET={{SLACK_CLIENT_SECRET}}
SLACK_TEAM_ID={{SLACK_TEAM_ID}}
SLACK_REDIRECT_URI={{SLACK_REDIRECT_URI}}

# --- авторизація на вході ---------------------------------------------------
# Гейт один — власний вхід лаби (логін+пароль або Slack-OIDC), учетка нижче,
# у блоці ADMIN_LOGIN / ADMIN_PASSWORD. BasicAuth-middleware Traefik тут
# СТОЯВ до 26.08 і знятий назавжди: два гейти на одному origin несумісні —
# застосунок віддає 401 без `WWW-Authenticate`, а браузер читає це як
# «Basic-пароль відхилено» і викидає його з кеша. Розгорнуто з вимірами —
# у `docker-compose.prod.yml` над лейблами роутера.

# --- GitLab, звідки лаба бере вітки ----------------------------------------
# Це ІНШИЙ GitLab-проєкт, ніж той, де лежить сама лаба: тут вона читає й
# комітить вайти. Токен окремий від персонального — Project Access Token
# (Developer + api), щоб радіус ураження був обмежений одним проєктом.
GITLAB_URL={{GITLAB_URL}}
GITLAB_PROJECT={{GITLAB_PROJECT}}
GITLAB_TOKEN={{GITLAB_TOKEN}}
#
# Порожній токен САМ вмикає мок (projects.py:52) — деплой без нього не падає,
# лаба просто читає вітки з fixtures/. Ця змінна потрібна для зворотного:
# ганяти мок-режим на проді, коли токен уже живий. Дефолт 0.
MOCK_MODE={{MOCK_MODE}}

# --- другий проєкт: node-вайти (опційно) ------------------------------------
# Порожні значення = проєкт просто не з'являється в перемикачі.
VUE_GITLAB_PROJECT={{VUE_GITLAB_PROJECT}}
VUE_GITLAB_TOKEN={{VUE_GITLAB_TOKEN}}

# --- ClickUp ----------------------------------------------------------------
CLICKUP_TOKEN={{CLICKUP_TOKEN}}
CLICKUP_VIEW_ID={{CLICKUP_VIEW_ID}}
CLICKUP_ME={{CLICKUP_ME}}

# --- Черга ClickUp -----------------------------------------------------------
# Порожній секрет = вебхук зачинений (401 на все). Решта параметрів черги має
# дефолти в коді; перемикачі «прийом» і «виконавець» — у стані, не тут.
CLICKUP_WEBHOOK_SECRET={{CLICKUP_WEBHOOK_SECRET}}
CU_QUEUE_ENABLED={{CU_QUEUE_ENABLED}}

# --- Telegram-вотчер (опційно) ----------------------------------------------
# Порожній токен = вотчер мовчить. ВАЖЛИВО: якщо десь паралельно піднята
# локальна лаба з тими самими значеннями, сповіщення прийдуть двічі.
TELEGRAM_BOT_TOKEN={{TELEGRAM_BOT_TOKEN}}
TELEGRAM_CHAT_ID={{TELEGRAM_CHAT_ID}}

# --- пошук стокових фото (опційно) ------------------------------------------
# Достатньо будь-якого одного; без жодного працює headless-скрейп magnific.
MAGNIFIC_API_KEY={{MAGNIFIC_API_KEY}}
PEXELS_API_KEY={{PEXELS_API_KEY}}
PIXABAY_API_KEY={{PIXABAY_API_KEY}}

# --- візуальні перевірки ----------------------------------------------------
# 1 воркер ≈ 1 фізичне ядро + 1.4 ГБ RAM. Дефолт 3×3 з'їв би ~4.5 ГБ, тому в
# проді свідомо менше — тримати в парі з limits.memory у compose.
VISUAL_WORKERS={{VISUAL_WORKERS}}
VISUAL_TABS={{VISUAL_TABS}}

# --- прогони перевірок --------------------------------------------------------
# Скільки процесів ганяють чеки. Чеки впираються в GIL: у потоках дві людини
# одночасно чекають удвічі довше кожна (заміряно 21.09.2026: 55 с проти 12-23 с
# у процесах на пачці з 8 віток). 0 — потоки, як раніше. Кожен воркер — ще
# ~100 МБ RAM, тож тримати в парі з VISUAL_WORKERS і limits.memory.
CHECK_WORKERS={{CHECK_WORKERS}}

# --- дані, якими прогін заповнює контактну форму ----------------------------
FORM_TEST_NAME={{FORM_TEST_NAME}}
FORM_TEST_EMAIL={{FORM_TEST_EMAIL}}
FORM_TEST_PHONE={{FORM_TEST_PHONE}}
