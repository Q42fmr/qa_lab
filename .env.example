# URL твого GitLab
GITLAB_URL=https://gitlab.example.com
# Шлях до проєкту (namespace/project), як у лінках
GITLAB_PROJECT=development/white-pages
# Personal Access Token зі скоупами: api (читання + коміти)
# GitLab -> Preferences -> Access Tokens
GITLAB_TOKEN=
# 1 = працювати з локальними папками fixtures/<branch> замість GitLab
MOCK_MODE=0
# Шлях до php.exe для локального деплою віток
PHP_BIN=php
# Редактори для кнопок «PhpStorm» / «VS Code» у вкладці Файли (необовʼязково)
# PHPSTORM_BIN=C:\Program Files\JetBrains\PhpStorm\bin\phpstorm64.exe
# VSCODE_BIN=code
# необов'язково: браузер для скріншотів (за замовчуванням шукається Edge/Chrome)
# BROWSER_BIN=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
# необов'язково: node для Lighthouse (за замовчуванням береться з PATH)
# NODE_BIN=node
# візуальні перевірки: скільки віток одночасно і скільки табів на вітку
# (типово 3 і 3; таби — окремі вікна, інакше скрін фонового таба висить)
# VISUAL_WORKERS=3
# VISUAL_TABS=3
# дані, якими прогін заповнює контактну форму (перевірка «ввід → подяка»);
# у вкладці «Візуальні» їх теж можна ввести руками на один прогін
# FORM_TEST_NAME=Ana Test
# FORM_TEST_LASTNAME=Silva
# FORM_TEST_EMAIL=qa.lead@example.com
# FORM_TEST_PHONE=+52 55 1234 5678
# FORM_TEST_COMPANY=QA Lab
# FORM_TEST_CITY=Test City
# FORM_TEST_MESSAGE=Mensagem de teste automatico (qa_lab). Ignore.

# --- пошук стокових фото (вкладка Медіа → «🔍 Знайти фото») ---
# достатньо БУДЬ-ЯКОГО одного ключа; пріоритет: magnific → pexels → pixabay
# magnific.com (колишній Freepik API; ключ вмикає саппорт: Dashboard → Contact us)
# MAGNIFIC_API_KEY=
# pexels.com/api — безкоштовний ключ одразу після реєстрації (200 запитів/год)
# PEXELS_API_KEY=
# pixabay.com/api/docs — безкоштовний ключ на сторінці доки після логіну
# PIXABAY_API_KEY=

# --- Telegram-бот: фоновий аналіз тасок → сповіщення ---
# токен від @BotFather
TELEGRAM_BOT_TOKEN=
# куди слати: напиши боту будь-що і відкрий /api/telegram/discover_chat — покаже id
TELEGRAM_CHAT_ID=
# період фонового аналізу у хвилинах (дефолт 30)
# TELEGRAM_POLL_MIN=30
# твій username у ClickUp — за ним шукаються згадки у коментарях
CLICKUP_ME=Nora Frontend

# --- ClickUp інтеграція ---
# Personal API Token: ClickUp -> Settings -> Apps -> API Token (pk_...)
CLICKUP_TOKEN=
# id в'ю (з URL: .../v/l/<VIEW_ID>), можна кілька через кому —
# в'ю бачить і таски з розшарених списків, які team-ендпоінт ховає
CLICKUP_VIEW_ID=
# необов'язково: id воркспейсу (визначається автоматично, якщо порожнє)
# CLICKUP_TEAM_ID=
# необов'язково (дефолти) — назви полів/чекліста і статуси:
# CLICKUP_FIELD=safe page
# CLICKUP_DOMAINS_FIELD=required domains
# CLICKUP_WTYPE_FIELD=тип вайта
# CLICKUP_CHECKLIST=whites
# CLICKUP_STATUSES=to do,in progress
# CLICKUP_STATUSES_EXCLUDE=content
# CLICKUP_TAGS_EXCLUDE=blacks   таски з цими тегами не наші взагалі (блек — інша
#                               сторінка: ні Safe Page, ні доменів у неї немає)

# --- Черга ClickUp (вебхук → черга → кнопка) ---
# Секрет підпису вебхука. ЗАПОВНЮВАТИ НЕ ТРЕБА: якщо є CLICKUP_TOKEN і
# DOMAIN_NAME, лаба на старті реєструє вебхук сама і кладе виданий ClickUp
# ключ у стан (том `qa_lab-state`, файл cu_webhook.json). Заповнений рядок
# означає РУЧНИЙ режим: тоді лаба в ClickUp не ходить узагалі і вірить цьому
# ключу — так робиться, коли вебхук завели руками
# (`qa_lab-work/clickup-webhook.py create <https://...>`).
# Порожній рядок і відсутня реєстрація = двері зачинені: /api/hook/clickup
# відповість 401 на будь-яке тіло.
CLICKUP_WEBHOOK_SECRET=
# CU_WEBHOOK_AUTO=0       вимкнути саму автореєстрацію (лишити двері закритими)
# CU_WEBHOOK_TRIES=8      скільки разів пробувати, якщо ClickUp недоступний
# 0 — сховати перемикачі черги взагалі (вето стенда).
# Самі перемикачі живуть у стані і за замовчуванням ВИМКНЕНІ: увімкнена
# черга починає качати знімки (615 віток ≈ 2 ГБ), це має бути свідомим
# натисканням, а не наслідком деплою.
# CU_QUEUE_ENABLED=1
# необов'язково (дефолти):
# CU_QUEUE_MAX=100        межа черги у ТАСКАХ (одна таска ≈ 4.7 вітки)
# CU_BRANCH_MAX=30        стеля віток на таску
# CU_TASKS_CAP=300        скільки тасок тримаємо у вкладці
# CU_POLL_MIN=30          страхувальний опит: вебхук ClickUp глушить себе сам
# CU_QUEUE_GROUPS=auto,tests   review не ганяємо: 100% і 94% хибних спрацювань
# CU_AUTOCOMMIT_MAX=10    стеля автокоміту НА ТАСКУ: поганий фікс однаково поганий
#                         на всіх вітках, решта лишається кнопці. Сам автокоміт —
#                         перемикач у вкладці «Черга», за замовчуванням вимкнений

# --- Ключі окремого сервісу local_setter_whites (порт 8040) ---
# Лаба їх НЕ читає: пайплайн локальних вайтів винесено в сусідній сервіс.
# Вони лишаються тут тому, що `paths.load_env()` того сервісу читає свій
# .env, а якщо його немає - падає на цей файл (щоб не тримати один
# ClickUp-токен у двох копіях). Прибирати їх звідси можна лише разом зі
# створенням local_setter_whites/.env.
# шаблонні файли, що сетяться у кожен вайт на етапі Copy_Files
LOCAL_TEMPLATE_DIR=/path/to/local-templates
# themes.json зі старого Image_setter - для кнопки «⬇ імпорт themes.json»
IMAGE_SETTER_THEMES=/path/to/themes.json
# ключ detectlanguage.com для чеку мови (без ключа чек пропускається)
# DETECTLANGUAGE_KEY=
# скільки .php/.html очікується у кожному вайті (чек файлнеймів)
# LOCAL_EXPECTED_FILES=9

# --- Прев'ю вітки на окремому піддомені ---
# Хост, на якому лаба віддає підняту вітку «як сайт» — щоб її можна було
# поклацати з браузера. Порожньо = вимкнено (це і є єдиний вимикач): кнопки в
# UI немає, розвилка по Host не спрацьовує, лаба поводиться точно як раніше.
# Локально вмикати сенсу мало: деплой і так доступний на 127.0.0.1:9100+.
# Ім'я мусить бути ОДНИМ лейблом під базовим доменом
# (lab-preview.example.com, а НЕ preview.lab.example.com) —
# інакше воно не потрапляє під wildcard-DNS і wildcard-серт.
PREVIEW_HOST=

# --- Вхід у лабу (авторизація) ---
# З'явилася разом з виходом лаби на спільний домен. Локально теж діє: без
# логіна UI не відкриється, тому як мінімум ADMIN_PASSWORD задати треба.
#
# Адмін — єдина учетка з правами адміністратора. Створюється (і оновлює
# пароль) на КОЖНОМУ старті, тож це і спосіб змінити пароль, і гарантія,
# що вхід лишиться, навіть якщо Slack ліг.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
# ADMIN_NAME=Administrator

# --- База (MongoDB) ---
# Порожньо або взагалі без рядка — лаба працює на json-файлах у корені стану
# (users.json тощо). Заповнено — колекція в Mongo, як на проді.
#
# У docker-режимі базу піднімає сам compose (сервіс `mongo`) і лаба
# ПІДКЛЮЧАЄТЬСЯ до неї за замовчуванням — рядок нижче для цього НЕ потрібен.
# Щоб навпаки, лишитись на файлах, розкоментуй порожній MONGO_URI:
# MONGO_URI=
#
# Для НАТИВНОГО запуску (server.sh) поруч із піднятим compose — база
# видно на петлі:
# MONGO_URI=mongodb://qa_lab:qa_lab@127.0.0.1:27017/?authSource=admin
#
# Довільна чужа база — повний рядок підключення:
# MONGO_URI=mongodb://user:pass@host:27017/?authSource=admin
# MONGO_DB=qa_lab
# MONGO_USERS_COLL=users
# Скіли ШІ-моста (правляться з вкладки /ai)
# MONGO_SKILLS_COLL=ai_skills
# Логін/пароль і порт локального контейнера бази (діють лише в compose):
# MONGO_USER=qa_lab
# MONGO_PASSWORD=qa_lab
# MONGO_PORT=27017

# --- ШІ-міст (запити від TSM) ---
# Модуль приймає скарги прозою від другого застосунку конвеєра, обирає
# перевірки через Claude, ганяє їх і — коли дозволено — комітить.
#
# Токен машини. Порожньо — міст закритий (усі /api/ai/* віддають 401).
# Згенерувати: openssl rand -hex 32
# QA_LAB_BRIDGE_TOKEN=
#
# Ключ Claude. Порожньо — роутер працює на самих словах з карток скілів:
# гірше, але працює, і міст не падає. Подивитись різницю можна на
# POST /api/ai/dry-run з use_model=false.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5
#
# Право комітити. 0 (дефолт) — сухий прогін: усе рахується і пишеться в
# журнал, у git не йде нічого.
# AI_BRIDGE_APPLY=0
# З яких груп чеків дозволено ЛАГОДИТИ (compute_fixes сам по GROUP не фільтрує)
# AI_AUTOFIX_GROUPS=auto
# Місячна стеля витрат на Claude, $. 0 — без обмеження.
# AI_BUDGET_USD=0
# 0 — не писати коментарі в ClickUp (зручно на час сухих прогонів)
# AI_CLICKUP=1
# Скільки кіл по одній проблемі, перш ніж кликати людину (третій раз = алерт)
# AI_MAX_ROUNDS=2
# Вікно, у якому повтор тієї самої проблеми — дубль, а не нове коло, сек
# AI_COOLDOWN_S=900

# Ключ підпису сесійної куки. Порожньо — згенерується сам і збережеться
# у .session_secret, тож рестарт не розлогінить.
# QA_LAB_SECRET_KEY=
# 1 — куку віддавати лише по https (на проді за Traefik саме так; локально 0)
# QA_LAB_COOKIE_SECURE=0

# Вхід через Slack (OIDC). Порожньо — кнопки на екрані входу просто немає.
# Локально не працює: Slack вимагає https-домен, тому перевіряється на проді.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_TEAM_ID=            # наш воркспейс; без нього вхід через Slack відхиляється
# SLACK_REDIRECT_URI=       # інакше виводиться з DOMAIN_NAME
