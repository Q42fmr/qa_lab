# =============================================================================
# qa_lab — що НЕ їде в репозиторій
# =============================================================================
# Правило одне: у git лежить тільки код. Стан лаби — json-файли і теки поруч
# з ним (БД немає, все на диску), тому список довгий і його треба поповнювати
# разом з кожним новим реєстром. Дзеркало цього файлу — `.dockerignore`:
# там те саме плюс те, що трекається, але образу не потрібне.

# --- секрети ----------------------------------------------------------------
# У процесі живуть токени GitLab і ClickUp, тож .env не має потрапити в git
# ЖОДНОГО разу: витягти його з історії потім набагато дорожче, ніж не
# закомітити зараз. Шаблони — навпаки, частина коду: з .env.prod.example
# пайплайн рендерить прод-конфіг.
.env
.env.*
!.env.example
!.env.prod.example

# авторизація: хеші паролів і ключ підпису сесійної куки — це стан, не код
users.json
.session_secret
# push-url із живим GitLab-токеном. Лежить локально й потрібен для роботи,
# але в публічний репозиторій не йде НІКОЛИ - без цього рядка будь-який
# `git add -A` заливає токен
_u.txt

# --- знімки віток і все, що з них росте ------------------------------------
# cache/ — це ще й вкладка «Архів»: знімок закритої вітки лишається єдиним
# слідом зробленої роботи, і перезняти його вже неможливо. Гігабайти.
cache/
deploy/
builder-*/
screens/
lighthouse/
visual/
buttons/
logs/

# --- реєстри стану (append-only і робочі) -----------------------------------
stats/
checkruns/
projects/
branches.json
# особисті списки віток (з 21.09.2026) і те, що відклала разова міграція
# після відкату деплою 23.09 (`app.retire_rolled_back_lists`)
branches.*.json
branches.*.json.retired-*
branches.retired-*
user_prefs.json
pinned.json
commits_log.json
checks_state.json
active_project.json
domains.json
problems.json
photo_db.json
visual_probe_out.json
visual_profiles.json
# ad-hoc звіт зонда: гілки зі зниклими map-PNG. Продюсера в коді немає,
# той самий рід, що problems.json і visual_probe_out.json вище
_missing_binaries.json
.deploy_pids.json
# пули юрномерів (regno_pool): стан, видалені, призначення вітка→номер.
# Сіди cnpj_seed.json / uid_seed.json — код, їдуть у репо
cnpj_pool.json
cnpj_removed.json
cnpj_assign.json
uid_pool.json
uid_removed.json
uid_assign.json
# id атрибутів форми-заглушки (form_stub): вітка → 6 літер
form_stub_ids.json

# --- ClickUp і Telegram -----------------------------------------------------
clickup_map.json
clickup_tasks.json
# стан черги ClickUp: таски з вироками і кільце дедупу подій вебхука
cu_queue.json
cu_hook_seen.json
# дошка «fixed уже є» (cu_fixed.py): хто вже відписав яку таску
clickup_fixed.json
stats_clickup_cache.json
comment_themes.json
tg_state.json

# --- MOCK_MODE -------------------------------------------------------------
# Без GITLAB_TOKEN вітки читаються звідси. Зразки для засіву лежать окремо, у
# docker/seed-fixtures/ — саме тому, що цей патерн git матчить на БУДЬ-ЯКІЙ
# глибині, і `docker/fixtures/` мовчки випадав би з комітів.
fixtures/

# --- локальний скрейп сторінки під ручну перевірку в браузері + сервер до нього
_ct/
_ct_serve.js

# --- python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# --- node (потрібен лише для lighthouse) ------------------------------------
node_modules/

# --- редактори й ОС ---------------------------------------------------------
# Не «про всяк випадок»: репозиторій живе на трьох машинах (Linux, Windows,
# RDP), і кожна норовить підкласти своє.
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- тимчасове --------------------------------------------------------------
*.bak
*.tmp
*.orig
*.rej
